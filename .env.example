# shot-video-creation — 仓库根目录 .env 模板
# 
# 复制为 .env 并填入真实 Key：cp .env.example .env
# .env 已 gitignore，不会入库
# 
# Skill 脚本启动时会自动加载本文件（dotenv 加载逻辑见 _shared/dotenv.py）
# 优先级：shell 环境变量 > .env 文件 > config.json

# ─────────────────────────────────────────────────────────────────────────
# volc-img-gen（火山方舟 Seedream 图像）
# 控制台：https://console.volcengine.com/ark
# ─────────────────────────────────────────────────────────────────────────
IMG_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
IMG_MODEL=doubao-seedream-5-0-260128
IMG_BASE=https://ark.cn-beijing.volces.com/api/v3

# ─────────────────────────────────────────────────────────────────────────
# volc-tts（火山豆包语音合成 2.0）
# 控制台：https://console.volcengine.com/ → 语音技术 → 应用管理
# ─────────────────────────────────────────────────────────────────────────
# 新版单头（推荐）
TTS_APP_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 旧版双头（与上面二选一）
TTS_APP_ID=
TTS_ACCESS_KEY=
TTS_RESOURCE_ID=seed-tts-2.0
TTS_BASE=https://openspeech.bytedance.com/api/v3

# ─────────────────────────────────────────────────────────────────────────
# volc-video-gen（火山方舟 Seedance 2.0 视频）
# 控制台：https://console.volcengine.com/ark
# ⚠️ 视频生成专用 Key，不与 ARK_API_KEY 混用
# ─────────────────────────────────────────────────────────────────────────
VIDEO_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VIDEO_BASE=https://ark.cn-beijing.volces.com/api/v3
